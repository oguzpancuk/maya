{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Read", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/contracts/track-read.sh" } ] },
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/contracts/evidence-gate.sh" } ] },
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/contracts/bash-guard.sh" },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.sh" } ] }
    ]
  }
}
